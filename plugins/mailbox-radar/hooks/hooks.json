{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/noderun.sh\" \"${CLAUDE_PLUGIN_ROOT}/scripts/inject.mjs\" --event SessionStart",
            "timeout": 10,
            "statusMessage": "掃交換區信箱"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/noderun.sh\" \"${CLAUDE_PLUGIN_ROOT}/scripts/inject.mjs\" --event PostToolUse",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
